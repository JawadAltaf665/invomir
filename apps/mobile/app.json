{
  "expo": {
    "name": "InvoMir",
    "slug": "invomir-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "invomir",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to securely unlock your InvoMir workspace."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC",
          "dark": {
            "backgroundColor": "#0F172A"
          }
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://localhost:5299",
      "apiPort": 5299,
      "webBillingUrl": "https://app.invomir.com/billing",
      "googleWebClientId": "91013579082-9uapuh4nca2dujsoc0jhl4fku738pvcl.apps.googleusercontent.com",
      "googleIosClientId": "91013579082-9uapuh4nca2dujsoc0jhl4fku738pvcl.apps.googleusercontent.com",
      "googleAndroidClientId": "91013579082-9uapuh4nca2dujsoc0jhl4fku738pvcl.apps.googleusercontent.com"
    },
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
